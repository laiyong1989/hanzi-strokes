<?xml version="1.0" encoding="UTF-8"?>
<!--
  开机自启：文件落盘后自动同步到 GitHub（macOS LaunchAgent）

  用法：
    1. 把下面 2 处 `__REPO__` 替换成你自己的 checkout 绝对路径
       （ProgramArguments 的脚本路径 与 WorkingDirectory）
    2. cp scripts/com.github.hanzi.autosync.plist ~/Library/LaunchAgents/
    3. launchctl load -w ~/Library/LaunchAgents/com.github.hanzi.autosync.plist

  常用命令：
    launchctl list | grep hanzi                 # 看是否在跑
    tail -f /tmp/hanzi-autosync.log             # 看同步日志
    launchctl unload -w ~/Library/LaunchAgents/com.github.hanzi.autosync.plist   # 停掉
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.hanzi.autosync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/scripts/watch-sync.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>INTERVAL</key>
        <string>5</string>
        <key>DEBOUNCE</key>
        <string>8</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 登录后启动；注销/关机时由 launchd 优雅停止 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/hanzi-autosync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hanzi-autosync.log</string>
</dict>
</plist>
